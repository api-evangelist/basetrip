{
  "opencollection": "1.0.0",
  "info": {
    "name": "Basetrip Cities Phrases API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Phrases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Phrases By Country",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.thebasetrip.com/v3/countries/:id/phrases",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Country slug or alpha-2 code"
              },
              {
                "name": "language",
                "value": "",
                "type": "query",
                "description": "Source language for translations (en, fr, de, it, es)"
              }
            ]
          },
          "docs": "Get travel phrases for the primary language of a country."
        }
      ]
    }
  ],
  "bundled": true
}